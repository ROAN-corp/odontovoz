    "@capacitor/share": "^7.0.0",
    "jspdf": "2.5.1",
    "@capacitor/app": "^7.0.0",
    "@capacitor-community/text-to-speech": "^6.0.0",
    "@capacitor-community/keep-awake": "~7.1.0",
    "@capacitor/local-notifications": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
